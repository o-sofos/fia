{
  // Type-checks the harness tooling (benchmarks, size and coverage gates),
  // which lives outside src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "incremental": true,
    "tsBuildInfoFile": "./tools.tsbuildinfo"
  },
  "include": ["bench", "scripts/size.ts", "scripts/coverage-gate.ts", "scripts/check-pure.ts", ".claude/hooks"],
  "exclude": ["node_modules", "dist", "benchmark_repo", "bench/.results"]
}
